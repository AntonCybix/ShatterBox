# Inställningar för ShatterBox. Kopieras till .env av "shatterbox setup".
# .env ska aldrig delas eller checkas in: där ligger dina Discord-tokens.
#
# Det mesta här går att ställa in utan att röra filen:
#   kontrollpanelen (shatterbox ui)  eller  shatterbox new / shatterbox edit

# --- Första karaktären ------------------------------------------------------
ASSISTANT_NAME=Assistenten
LANGUAGE=sv
# discord = en egen Discord-bot som går med i röstkanaler
# local   = finns bara på den här datorn, du pratar med den via "shatterbox talk"
BOT_MODE=discord
# Bot-token från https://discord.com/developers/applications -> din app -> Bot -> Reset Token
# Behövs inte för en lokal karaktär.
DISCORD_TOKEN=

# Karaktärsbeskrivning. Hellre i en fil: personas/<namn>.txt (namnet med små bokstäver och
# bindestreck, t.ex. personas/kapten-krok.txt). Filen läses om utan omstart.
PERSONA=
# Imitation av en verklig person: håller stilen, men säger ärligt att den är en bot om någon
# frågar på allvar. Utan den stannar karaktären alltid i rollen (passar påhittade figurer).
PARODY=false
# Designad röst om inget röstprov finns i voice/reference.*  Ord som går att kombinera:
#   male | female, child | teenager | young adult | middle-aged | elderly,
#   very low pitch | low pitch | moderate pitch | high pitch | very high pitch, whisper,
#   american | british | australian | canadian | indian ... accent   (accent bara för engelska)
VOICE_STYLE=
# Sägs när karaktären går med i en röstkanal eller när ett samtal i terminalen börjar
GREETING=

# --- Discord ----------------------------------------------------------------
# Ditt eget Discord-användar-ID (högerklicka på dig själv -> Kopiera användar-ID, kräver utvecklarläge).
# Om det är ifyllt och AUTO_JOIN=true följer botarna med dig in i röstkanaler automatiskt.
DISCORD_OWNER_ID=
AUTO_JOIN=true
# all = lyssna på alla i kanalen, owner = bara på dig
LISTEN_TO=all
# Avbryt boten när någon börjar prata medan den talar
BARGE_IN=true
# Boten tystnar först när så här många riktiga ord har uppfattats (skratt, hostningar och "mm"
# räknas inte). Orden tyst, stopp, sluta och vänta räcker ensamma.
BARGE_IN_WORDS=2
# Hur mycket ljud (ms) som ska ha kommit in innan första kontrollen görs
BARGE_IN_MS=600
# Hur länge (ms) det ska vara tyst innan boten räknar meningen som klar
SILENCE_MS=900

# --- Språkmodell --------------------------------------------------------------
OLLAMA_MODEL=gemma4:e2b
# Hur många tidigare repliker som skickas med som minne
HISTORY_TURNS=8

# --- Fler karaktärer -------------------------------------------------------
# Nästa karaktär heter BOT2_..., sedan BOT3_... upp till BOT9_. Alla delar på samma modeller,
# så de kostar inget extra när de är tysta. Enklast skapas de med "shatterbox new".
#   Persona: personas/<namn>.txt
#   Röst:    voice/<namn>.wav om den finns, annars en designad röst enligt VOICE_STYLE
#
# Exempel: en engelsk karaktär som bara finns lokalt
# BOT2_NAME=Captain Hook
# BOT2_MODE=local
# BOT2_LANGUAGE=en
# BOT2_VOICE_STYLE=male, middle-aged, low pitch, british accent
# BOT2_GREETING=Ahoy there!
#
# Exempel: en spelguide på Discord som bara svarar på sitt namn (se "Extra förmågor" i README.md)
# BOT3_DISCORD_TOKEN=
# BOT3_NAME=Guiden
# BOT3_LANGUAGE=sv
# BOT3_LISTEN_LANGUAGES=sv,en        # förstår båda språken
# BOT3_WAKE_ONLY=true                # tyst tills någon säger namnet
# BOT3_SEARCH_LANGUAGE=en            # söker på engelska
# BOT3_SEARCH_HINT=<spelets namn>    # läggs alltid till i sökfrågan
# BOT3_MEMORY=true                   # minns varje spelares karaktär (data/memory/guiden.json)
# BOT3_VOICE_STYLE=male, elderly, low pitch
# BOT3_MODEL=gemma4:e4b              # valfritt: större språkmodell bara för den här karaktären

# --- Tal-till-text ---------------------------------------------------------
# KBLab/kb-whisper-tiny | base | small | medium | large  (större = bättre men långsammare)
STT_MODEL=KBLab/kb-whisper-small
# Ord som ofta hörs fel (spelnamn, egennamn), kommaseparerade
STT_HOTWORDS=

# --- Talsyntes -------------------------------------------------------------
# 16 = snabbt, 32 = något högre kvalitet men dubbla väntetiden
TTS_STEPS=16
TTS_SPEED=1.0
# cpu tvingar talsyntesen att köra på processorn även om det finns ett grafikkort
# TTS_DEVICE=cpu
# Reservläge helt i Docker utan grafikkort (mycket långsamt, bara Windows):
#   TTS_URL=http://tts:8000   och sedan   docker compose --profile cpu up -d
# TTS_URL=http://host.docker.internal:8003

# --- Samtal i terminalen ---------------------------------------------------
# Vad karaktärerna kallar dig i "shatterbox talk" (annars ditt användarnamn på datorn)
# TALK_USER=
